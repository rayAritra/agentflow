# Express Port
PORT=5000

# MongoDB Configuration
# Replace with your MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/agentflow?retryWrites=true&w=majority

# Upstash Redis Configuration for BullMQ
# Get these from upstash.com
REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=

# JWT Authentication
JWT_SECRET=super_secret_jwt_key_change_me_in_production
JWT_EXPIRES_IN=30d

# AI Provider API Keys
# Groq - Primary AI (Free 14,400 req/day)
GROQ_API_KEY=
# Google Gemini - Fallback AI (Free 15 RPM)
GEMINI_API_KEY=
